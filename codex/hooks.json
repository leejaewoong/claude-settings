{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd /c \"%USERPROFILE%\\.claude\\scripts\\codex_hook.cmd hooks/bash_safelist_check.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cmd /c \"%USERPROFILE%\\.claude\\scripts\\codex_hook.cmd hooks/revise_claude_trigger.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "cmd /c \"%USERPROFILE%\\.claude\\scripts\\codex_hook.cmd hooks/session_sync_claude.sh\""
          },
          {
            "type": "command",
            "command": "cmd /c \"%USERPROFILE%\\.claude\\scripts\\codex_hook.cmd hooks/register_pubg_credential.sh\""
          },
          {
            "type": "command",
            "command": "cmd /c \"%USERPROFILE%\\.claude\\scripts\\codex_hook.cmd scripts/sync_codex.sh\""
          }
        ]
      }
    ]
  }
}
